{
  "name": "lodown",
  "productName": "LOHANA DX",
  "version": "1.0.40",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "prepare": "node scripts/prepare-ffmpeg.mjs",
    "start": "node scripts/prepare-ffmpeg.mjs && electron .",
    "dist": "node scripts/prepare-ffmpeg.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.lohana.media-downloader",
    "productName": "LOHANA DX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "engine/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/icon.ico",
      "executableName": "LOHANA-DX",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "LOHANA DX",
      "artifactName": "LOHANA-DX-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "lohana20061023-29",
      "repo": "media-downloader-app"
    },
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "ffmpeg.exe"
        ]
      },
      {
        "from": "engine/pysign",
        "to": "app.asar.unpacked/engine/pysign",
        "filter": [
          "*.py"
        ]
      }
    ]
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "engine/**/*",
    "renderer/**/*"
  ],
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.22.0"
  },
  "description": "LOHANA DX：B 站 / 抖音 / 小红书 / YouTube 等多平台下载器"
}
